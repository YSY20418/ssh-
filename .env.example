# ─────────────────────────────────────────────────────────────
# 阿渡 WebPilot · 环境变量模板
# 复制为 .env.local 后填写；.env.local 已被 .gitignore 忽略，密钥不会进仓库
# ─────────────────────────────────────────────────────────────

# 大模型 Provider（零成本优先）
# 可选：zhipu | siliconflow | openrouter | modelscope | dashscope | deepseek | local
# 免费额度说明见 README「零成本接入」一节
LLM_PROVIDER=zhipu

# 密钥：留空则自动降级为规则引擎，演示链路依然完整
LLM_API_KEY=

# 以下两项留空即使用 Provider 预设，通常无需填写
LLM_BASE_URL=
LLM_MODEL=

# 强制使用规则引擎（离线演示 / 使用者环境断网时设为 1）
USE_MOCK_ENGINE=0

# 安全策略：高危动作是否必须人工授权（1 = 必须，不建议关闭）
REQUIRE_HUMAN_CONFIRM=1
